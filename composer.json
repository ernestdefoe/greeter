{
    "name": "ernestdefoe/greeter",
    "description": "Welcome every new member with a private message, an email, or both — sent the moment they are actually in, written in your own words.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "welcome",
        "onboarding",
        "private message"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/greeter",
    "support": {
        "forum": "https://discuss.flarum.org/d/39996-greeter",
        "issues": "https://github.com/ernestdefoe/greeter/issues",
        "source": "https://github.com/ernestdefoe/greeter"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/messages": "Sends the welcome as one of Flarum's private messages.",
        "ernestdefoe/parley": "Sends the welcome as a Parley chat message instead.",
        "ernestdefoe/gatehouse": "Members held for approval are welcomed when they are approved, not when they sign up."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Greeter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Greeter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Greeter",
            "category": "feature",
            "icon": {
                "name": "fas fa-hand",
                "backgroundColor": "#d97706",
                "color": "#fff"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "ernestdefoe/parley": "^1.0",
        "flarum/messages": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
