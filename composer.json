{
    "name": "ernestdefoe/greeter",
    "description": "Welcome every new member with a private message, an email, or both — sent the moment they are actually in, written in your own words.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "welcome",
        "onboarding",
        "private message"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/greeter",
    "support": {
        "issues": "https://github.com/ernestdefoe/greeter/issues",
        "source": "https://github.com/ernestdefoe/greeter"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/messages": "Sends the welcome as one of Flarum's private messages.",
        "ernestdefoe/parley": "Sends the welcome as a Parley chat message instead.",
        "ernestdefoe/gatehouse": "Members held for approval are welcomed when they are approved, not when they sign up."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Greeter\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Greeter",
            "category": "feature",
            "icon": {
                "name": "fas fa-hand",
                "backgroundColor": "#d97706",
                "color": "#fff"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
